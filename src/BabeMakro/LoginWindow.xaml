<Window x:Class="BabeMakro.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BabeMakro - Login"
        Height="500"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#44475A"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#6272A4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#44475A"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#6272A4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#6272A4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7082B6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#5A6A9C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#44475A"/>
                                <Setter Property="Foreground" Value="#6C6F85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E2E" CornerRadius="10" BorderBrush="#44475A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#282A36" CornerRadius="10,10,0,0" MouseLeftButtonDown="Border_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="BabeMakro Login"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Left"
                             Margin="15,0,0,0"
                             Foreground="White"
                             FontSize="14"
                             FontWeight="SemiBold"/>

                    <Button Grid.Column="1"
                          Content="✕"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          Background="Transparent"
                          Foreground="White"
                          BorderThickness="0"
                          FontSize="16"
                          Width="30"
                          Height="30"
                          Cursor="Hand"
                          Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="40,0">
                <TextBlock Text="Welcome Back!"
                         FontSize="28"
                         FontWeight="Bold"
                         Foreground="White"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,10"/>

                <TextBlock Text="Please login to continue"
                         FontSize="14"
                         Foreground="#6C6F85"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,40"/>

                <TextBlock Text="Email"
                         Foreground="#6C6F85"
                         FontSize="12"
                         Margin="0,0,0,8"/>
                <TextBox x:Name="EmailTextBox"
                        Style="{StaticResource ModernTextBox}"
                        Margin="0,0,0,20"
                        KeyDown="TextBox_KeyDown"/>

                <TextBlock Text="Password"
                         Foreground="#6C6F85"
                         FontSize="12"
                         Margin="0,0,0,8"/>
                <PasswordBox x:Name="PasswordBox"
                           Style="{StaticResource ModernPasswordBox}"
                           Margin="0,0,0,30"
                           KeyDown="PasswordBox_KeyDown"/>

                <Button x:Name="LoginButton"
                       Content="LOGIN"
                       Style="{StaticResource ModernButton}"
                       Click="LoginButton_Click"
                       Margin="0,0,0,20"/>

                <TextBlock HorizontalAlignment="Center">
                    <Run Text="Don't have an account?" Foreground="#6C6F85"/>
                    <Hyperlink x:Name="RegisterLink"
                             Foreground="#6272A4"
                             TextDecorations="None"
                             Click="RegisterLink_Click">
                        <Run Text="Register"/>
                    </Hyperlink>
                </TextBlock>

                <ProgressBar x:Name="LoadingProgressBar"
                           IsIndeterminate="True"
                           Height="3"
                           Margin="0,20,0,0"
                           Visibility="Collapsed"
                           Foreground="#6272A4"
                           Background="Transparent"
                           BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>